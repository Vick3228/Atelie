<%- include('../cabecalho')%>

<main class="pagina-cadastro-produto">
    <div class="cadastro-produto-container">
        <h3 class="cadastro-produto-titulo">Editar Material</h3>
        </h3>

        <form method="post">
            <div class="cadastro-produto-grid">
                <div class="cadastro-produto-voltar">
                    <a href="/materiais">← Voltar</a>
                </div>

                        <div class="cadastro-produto-field">
                            <label for="material">Material</label>
                            <input value="<%= materiais.material %>" id="material" name="material" type="text" placeholder="Ex.: Tecido" required>
                        </div>

                        <div class="cadastro-produto-field">
                            <label for="categoria">Categoria</label>
                            <input value="<%= materiais.categoria %>" id="categoria" name="categoria" type="text" placeholder="Ex.: Tela" required>
                        </div>

                        <div class="cadastro-produto-field">
                            <label for="estoque">Estoque</label>
                            <input value="<%= materiais.estoque %>" id="estoque" name="estoque" type="text" placeholder="Ex.: 100" required>
                        </div>

                        <div class="cadastro-produto-field">
                            <label for="disponibilidade">Disponibilidade</label>
                            <input value="<%= materiais.disponibilidade %>" id="disponibilidade" name="disponibilidade" type="text" placeholder="Ex.: Total" required>
                        </div>

                        <div class="cadastro-produto-field cadastro-produto-descricao">
                            <label for="situacao">Situação do material</label>
                            <textarea id="situacao" name="situacao" placeholder="Ex.: Novo, Antigo..."><%= materiais.situacao %></textarea>
                        </div>
            </div>

            <div class="cadastro-produto-acoes">
            <a href="/materiais" class="btn-limpar-produto">Cancelar</a>
            <button type="submit" class="btn-salvar-produto">Salvar alterações</button>
        </div>
        </form>
    </div>
</main>

</div>
</body>
</html>