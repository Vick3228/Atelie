<%- include('./cabecalho')%>
  <main class="main">
    <div class="topbar">
      <div class="breadcrumb">Ateliê Digital <span aria-hidden="true">/</span> Painel de Resumo</div>
      <div class="top-actions"><span class="date-label">✧ Organização que inspira criatividade</span><a
          class="button secondary" href="index">⌂ Início</a></div>
    </div>

    <header class="page-heading">
      <div>
        <div class="eyebrow">Visão geral</div>
        <h1>Bom dia! ✿</h1>
        <p>Aqui está o resumo do seu ateliê. Um passo de cada vez.</p>
      </div>
      <a class="button" href="/encomendas">＋ Nova encomenda</a>
    </header>
    <section class="grid stats" aria-label="Indicadores do ateliê">
      <article class="card">
        <div class="stat-top">Encomendas pendentes <span class="stat-icon">▤</span></div>
        <div class="stat-value">
          <%= qtdEncomendas %>
        </div>
      </article>
      <article class="card">
        <div class="stat-top">Materiais cadastrados <span class="stat-icon">◉</span></div>
        <div class="stat-value">
          <%= qtdMateriais %>
        </div>
      </article>
      <article class="card">
        <div class="stat-top">Produtos cadastrados <span class="stat-icon">♡</span></div>
        <div class="stat-value">
          <%= qtdProdutos %>
        </div>
      </article>
      <article class="card">
        <div class="stat-top">Resumo de lucro <span class="stat-icon">✧</span></div>
        <div class="stat-value">
          R$ <%= totalEncomendas.toFixed(2) %>
        </div>
        <div class="stat-note">Aguardando dados</div>
      </article>
    </section>
    <section class="grid content-grid">
      <article class="card">
        <div class="section-head">
          <h2>Resumo financeiro</h2><span class="muted small">Últimos 6 meses</span>
        </div>
        <div class="chart-wrap">
          <div class="note">O resumo financeiro será exibido aqui quando houver dados cadastrados.</div>
        </div>
      </article>
      <article class="card">
        <div class="section-head">
          <h2>Encomendas pendentes</h2><a class="text-link" href="encomendas">Ver todas →</a>
        </div>
        <div class="note">Nenhuma encomenda cadastrada até o momento.</div>
      </article>
    </section>

    <footer class="footer">Feito por: Vitória Navarro ✿</footer>
  </main>
  </div>
  </body>

  </html>