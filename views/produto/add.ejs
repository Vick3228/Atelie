<%- include('../cabecalho')%>

<main class="pagina-cadastro-produto">

            <div class="cadastro-produto-container">

                <h3 class="cadastro-produto-titulo">Novo produto</h3>

                <form method="POST" action="/produtos/add">

                    <div class="cadastro-produto-grid">

                        <div class="cadastro-produto-voltar">
                            <a href="/produtos">← Voltar</a>
                        </div>

                        <div class="cadastro-produto-field">
                            <label for="nome">Nome do produto</label>
                            <input id="nome" name="nome" type="text" placeholder="Ex.: Bolsa Aurora" required>
                        </div>

                        <div class="cadastro-produto-field">
                            <label for="precovenda">Preço de venda (R$)</label>
                            <input id="precovenda" name="precovenda" type="number" step="0.01" placeholder="0,00" required>
                        </div>

                        <div class="cadastro-produto-field">
                            <label for="materiais">Materiais</label>
                            <input id="materiais" name="materiais" type="text"
                                placeholder="Ex.: fio de algodão, alça, forro">
                        </div>

                        <div class="cadastro-produto-field cadastro-produto-descricao">
                            <label for="descricao">Descrição</label>
                            <textarea id="descricao" name="descricao"
                                placeholder="Descreva detalhes, tamanho e personalizações"></textarea>
                        </div>

                    </div>

                    <div class="cadastro-produto-acoes">
                        <button type="reset" class="btn-limpar-produto">Limpar</button>
                        <button type="submit" class="btn-salvar-produto">Salvar produto</button>
                    </div>

                </form>

            </div>

        </main>

        </body>

        </html>
    </main>