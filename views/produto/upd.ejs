<%- include('../cabecalho')%>

<main class="pagina-cadastro-produto">
    <div class="cadastro-produto-container">
        <h3 class="cadastro-produto-titulo">Editar Produto</h3>

        <form method="post">
            <div class="cadastro-produto-grid">
                <div class="cadastro-produto-voltar">
                    <a href="/produtos">← Voltar</a>
                </div>

                <div class="cadastro-produto-field">
                    <label for="nome">Nome do Produto</label>
                    <input id="nome" type="text" name="nome" value="<%=produto.nome%>" required>
                </div>

                <div class="cadastro-produto-field">
                    <label for="precovenda">Preço de Venda (R$)</label>
                    <input id="precovenda" type="number" step="0.01" name="precovenda" value="<%=produto.precovenda%>" required>
                </div>

                <div class="cadastro-produto-field">
                    <label for="materiais">Materiais</label>
                    <input id="materiais" type="text" name="materiais" value="<%=produto.materiais%>">
                </div>

                <div class="cadastro-produto-field cadastro-produto-descricao">
                    <label for="descricao">Descrição</label>
                    <input id="descricao" type="text" name="descricao" value="<%=produto.descricao%>">
                </div>
            </div>

            <div class="cadastro-produto-acoes">
    <a href="/produtos" class="btn-limpar-produto">Cancelar</a>
    <button type="submit" class="btn-salvar-produto">Salvar alterações</button>
</div>
        </form>
    </div>
</main>

</div>
</body>
</html>